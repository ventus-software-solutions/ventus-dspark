#!/usr/bin/env bash
# ventus-dspark — one command to serve DeepSeek-V4-Flash-0731 on 2x DGX Spark.
#
#   ./ventus-dspark up --worker <worker-ip> --model <weights-dir> [--port 8000]
#   ./ventus-dspark down
#
# Run on the HEAD node. Everything else is automatic:
#   - IB HCA/GID probe (picks the port with a usable RoCEv2 GID — the second
#     port on many Sparks has none and kills NCCL silently),
#   - dspark_block_size (k) validation (the model card says 7, the checkpoint
#     says 5 — k=7 crashes on first generation),
#   - worker-first launch, health wait, minimal smoke request.
#
# The runtime image defaults to ventus/dspark-vllm:0731-0.1.0 — build it with
# scripts/build.sh or point --image at your own build. No .env editing.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_DIR="$SCRIPT_DIR/.ventus"
ENV_FILE="$ENV_DIR/env.dspark"
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=8)

# Engine lane: 025 (default, Anemll vLLM 0.25 port — +8% decode, +15% KV
# pool vs 021, see docs/VALIDATION.md) or 021 (bjk110 base, kept for
# rollback). Each lane has its own compose file and image; they are not
# mix-and-match — overlay files from one vLLM version crash the other.
ENGINE="${VENTUS_ENGINE:-025}"
IMAGE="${VENTUS_IMAGE:-}"
VLLM_PORT=8000
MASTER_PORT=25000
# $USER is unset under cron, systemd and non-interactive ssh; set -u turns
# that into a crash before the first line of output.
WORKER_USER="${VENTUS_WORKER_USER:-${USER:-$(id -un)}}"
DRY_RUN=0
DASH_PORT="${VENTUS_DASH_PORT:-8500}"
# Optional speculative-config additions, e.g. (see docs/EXPERIMENTS.md):
#   VENTUS_SPEC_EXTRA=',"rejection_sample_method":"block"'
# Block verification (Sun et al. 2403.10444) is lossless and measured
# non-negative; it only engages at temperature > 0. Override to '' to drop it.
VENTUS_SPEC_EXTRA="${VENTUS_SPEC_EXTRA-,\"rejection_sample_method\":\"block\"}"

# Validated engine constants — changing any of these without re-measuring on
# the same hardware is how you lose the numbers in docs/VALIDATION.md.
GPU_MEMORY_UTILIZATION="${VENTUS_GMU:-}"
MAX_NUM_SEQS="${VENTUS_SEQS:-6}"
# Server-side reasoning default. The 0731 checkpoint has no Jinja
# chat_template; its encoding_dsv4.py encoder takes off|low|high|max. "low"
# is the base mode (opens <think>, no effort prefix). Request-level
# chat_template_kwargs always win over this.
DEFAULT_THINKING="${VENTUS_THINKING:-off}"
MAX_NUM_BATCHED_TOKENS=8192
MTP_NUM_TOKENS=""
MAX_MODEL_LEN=""
NCCL_IB_GID_INDEX=""
NCCL_IB_HCA=""
NCCL_SOCKET_IFNAME=""

resolve_engine() {
  case "$ENGINE" in
    021)
      COMPOSE="$SCRIPT_DIR/compose/ventus-dspark.yml"
      [ -n "$IMAGE" ] || IMAGE="ghcr.io/ventus-software-solutions/dspark-vllm:0731-0.1.0"
      # 0.80 dies on the first real request on this lane; see VALIDATION.md.
      [ -n "$GPU_MEMORY_UTILIZATION" ] || GPU_MEMORY_UTILIZATION=0.78
      ;;
    025)
      COMPOSE="$SCRIPT_DIR/compose/ventus-dspark-025.yml"
      [ -n "$IMAGE" ] || IMAGE="ghcr.io/ventus-software-solutions/dspark-vllm:0731-025-0.1.0"
      # 0.78, not Anemll's 0.80: the worker accumulated NVRM out-of-memory
      # kernel checks over 20h at 0.80 and hard-hung (2026-08-05) — the same
      # margin lesson VALIDATION.md already recorded for the 021 lane.
      [ -n "$GPU_MEMORY_UTILIZATION" ] || GPU_MEMORY_UTILIZATION=0.78
      ;;
    *) fatal "--engine must be 021 or 025 (got '$ENGINE')" ;;
  esac
}

usage() {
  sed -n '2,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  echo
  echo "Commands:"
  echo "  up      start serving (add --dry-run to print config without starting)"
  echo "  down    stop serving on both nodes"
  echo "  status  show fleet health, model, KV pool, decode + draft acceptance"
  echo "  dashboard  serve the same view as a web page (default :8500)"
  echo
  echo "Options (up):"
  echo "  --worker <ip>     worker node fabric IP (required)"
  echo "  --model <dir>     weights directory on BOTH nodes (default ~/models/v4-flash-0731)"
  echo "  --port <n>        API port (default 8000)"
  echo "  --image <tag>     runtime image (default depends on --engine)"
  echo "  --thinking <lvl>  default reasoning effort: off|low|high|max (default off)"
  echo "  --engine <lane>   025 (default, vLLM 0.25) or 021 (rollback lane)"
  echo "  --dash-port <n>   dashboard port (default 8500)"
  echo "  --stop            (with dashboard) stop it and its telemetry collector"
}

log() { printf '\033[36m[ventus-dspark]\033[0m %s\n' "$*"; }
fatal() { printf '\033[31m[ventus-dspark FATAL]\033[0m %s\n' "$*" >&2; exit 1; }

run_worker() { ssh "${SSH_OPTS[@]}" "${WORKER_USER}@$WORKER" "$@"; }

probe_ib() {
  # Pick the IB device+port whose RoCEv2 GID is usable. A link-local (fe80)
  # GID at the selected index or an all-zeros one means no RoCEv2 on that
  # port. The working IPv4-mapped GID looks like
  # 0000:0000:0000:0000:0000:ffff:c0a8:0102 — leading zeros are normal.
  local host="$1" out dev port idx gid
  if [ "$host" = "local" ]; then
    out="$(for d in /sys/class/infiniband/*/; do
      dev="$(basename "$d")"
      for p in "$d"ports/*/; do
        port="$(basename "$p")"
        for idx in 3 2 1; do
          [ -r "$p"gids/$idx ] || continue
          IFS= read -r gid < "$p"gids/$idx || true
          case "$gid" in
            ""|fe80:*) continue ;;
            0000:0000:0000:0000:0000:0000:0000:0000) continue ;;
            *) echo "$dev:$port:$idx" ;;
          esac
        done
      done
    done | head -1)"
  else
    out="$(run_worker 'for d in /sys/class/infiniband/*/; do dev=$(basename "$d"); for p in "$d"ports/*/; do port=$(basename "$p"); for idx in 3 2 1; do [ -r "$p"gids/$idx ] || continue; IFS= read -r gid < "$p"gids/$idx || true; case "$gid" in ""|fe80:*) continue ;; 0000:0000:0000:0000:0000:0000:0000:0000) continue ;; *) echo "$dev:$port:$idx" ;; esac; done; done; done | head -1')"
  fi
  [ -n "$out" ] || fatal "no usable RoCEv2 GID found on $host — check the IB fabric"
  echo "$out"
}

checkpoint_k() {
  # dspark_block_size from the checkpoint config; the model card's
  # num_speculative_tokens (7) is NOT the drafter geometry.
  python3 - "$MODEL/config.json" <<'PY'
import json, sys
cfg = json.load(open(sys.argv[1]))
print(cfg.get("dspark_block_size", 5))
PY
}

checkpoint_ctx() {
  python3 - "$MODEL/config.json" <<'PY'
import json, sys
cfg = json.load(open(sys.argv[1]))
print(cfg.get("max_position_embeddings", 1048576))
PY
}

gen_env() {
  mkdir -p "$ENV_DIR"
  cat > "$ENV_FILE" <<EOF
# Generated by ventus-dspark $(date -Is) — do not hand-edit.
WORKER_HOST=$WORKER
MASTER_ADDR=$HEAD_IP
MASTER_PORT=$MASTER_PORT
NODE_RANK=0
HEADLESS=
VLLM_HOST_IP=$HEAD_IP
WORKER_VLLM_HOST_IP=$WORKER
NCCL_IB_HCA=$NCCL_IB_HCA
NCCL_IB_GID_INDEX=$NCCL_IB_GID_INDEX
NCCL_SOCKET_IFNAME=$NCCL_SOCKET_IFNAME
NCCL_CROSS_NIC=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_XET=1
HF_CACHE=$HOME/.cache/huggingface
MODELS_DIR=$(dirname "$MODEL")
DSPARK_MODEL=/models/$(basename "$MODEL")
SERVED_MODEL_NAME=/models/$(basename "$MODEL")
VLLM_PORT=$VLLM_PORT
VLLM_HOST=0.0.0.0
API_URL=http://127.0.0.1:$VLLM_PORT/v1/models
CHAT_URL=http://127.0.0.1:$VLLM_PORT/v1/chat/completions
DSPARK_VLLM_IMAGE=$IMAGE
MAX_MODEL_LEN=$MAX_MODEL_LEN
MAX_NUM_SEQS=$MAX_NUM_SEQS
MAX_NUM_BATCHED_TOKENS=$MAX_NUM_BATCHED_TOKENS
GPU_MEMORY_UTILIZATION=$GPU_MEMORY_UTILIZATION
MTP_NUM_TOKENS=$MTP_NUM_TOKENS
SPECULATIVE_CONFIG_JSON={"method":"dspark","num_speculative_tokens":$MTP_NUM_TOKENS,"draft_sample_method":"probabilistic"$VENTUS_SPEC_EXTRA}
DEFAULT_THINKING=$DEFAULT_THINKING
VLLM_USE_FLASHINFER_SAMPLER=1
VLLM_USE_B12X_MOE=1
VLLM_USE_B12X_WO_PROJECTION=1
VLLM_DSPARK_CONFIDENCE_THRESHOLD=0.0
VLLM_DSPARK_CONFIDENCE_SCHEDULER=off
VLLM_DSPARK_LOCAL_ARGMAX=1
VLLM_DSPARK_REPLICATE_MARKOV_W1=1
VLLM_DSPARK_FUSED_MARKOV_ARGMAX=0
VLLM_DSPARK_GPU_REJECTED_CONTEXT_MASK=1
VLLM_DSPARK_REFERENCE_KV_QUANT_DEQUANT=0
VLLM_DSPARK_HARDWARE_SCHEDULER_EARLY_STOP=1
VLLM_B12X_W4A16_FORCE_BLOCKS_PER_SM=0
VLLM_B12X_W4A16_FORCE_BLOCKS_MAX_M=16
B12X_W4A16_TC_DECODE=0
VLLM_DSV4_B12X_COMPRESSED_MLA=0
VLLM_DSV4_DSPARK_DEFER_TARGET_CAPTURE=0
VLLM_DSV4_DSPARK_DEFER_TARGET_CAPTURE_EXACT=0
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_TRITON_MLA_SPARSE=1
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
FLASHINFER_DISABLE_VERSION_CHECK=1
