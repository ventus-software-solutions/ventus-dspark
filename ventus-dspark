}

cmd_up() {
  [ -n "$WORKER" ] || { usage; fatal "--worker is required"; }
  if [ ! -f "$MODEL/config.json" ]; then
    log "no weights at $MODEL — to fetch them (resumable, ~155 GB for 0731):"
    log "  ./scripts/fetch-weights.sh --dir $MODEL"
    log "then copy to the worker over the fabric link:"
    log "  rsync -a --partial --info=progress2 $MODEL/ $WORKER:$MODEL/"
    fatal "weights missing on the head node"
  fi
  command -v docker >/dev/null || fatal "docker not found on head"
  run_worker "command -v docker >/dev/null" || fatal "docker not found on worker ($WORKER)"
  if ! run_worker "[ -f '$MODEL/config.json' ]"; then
    log "weights missing on the worker — copy them over the fabric link:"
    log "  rsync -a --partial --info=progress2 $MODEL/ $WORKER:$MODEL/"
    fatal "weights missing on the worker ($WORKER)"
  fi

  HEAD_IP="$(ip route get "$WORKER" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')"
  [ -n "$HEAD_IP" ] || fatal "cannot determine head fabric IP for route to $WORKER"

  log "probing IB on head + worker..."
  local local_ib worker_ib
  local_ib="$(probe_ib local)"
  worker_ib="$(probe_ib worker)"
  [ "${local_ib%%:*}" = "${worker_ib%%:*}" ] || fatal "head HCA ${local_ib%%:*} != worker HCA ${worker_ib%%:*} — check the fabric"
  NCCL_IB_HCA="${local_ib%%:*}"
  NCCL_IB_GID_INDEX="${local_ib##*:}"
  NCCL_SOCKET_IFNAME="$(ip route get "$WORKER" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')"
  log "IB: $NCCL_IB_HCA gid=$NCCL_IB_GID_INDEX eth=$NCCL_SOCKET_IFNAME"

  BLOCK_K="$(checkpoint_k)"
  # k=7 on the 025 lane: +8.8% single-stream over the checkpoint's block of 5,
  # measured 2026-08-06 with byte-identical greedy output (docs/EXPERIMENTS.md).
  # The 021 lane crashes above 5, so it keeps the checkpoint value.
  if [ "$ENGINE" = "025" ] && [ "$BLOCK_K" = "5" ]; then
    MTP_NUM_TOKENS="${VENTUS_K:-7}"
  else
    MTP_NUM_TOKENS="${VENTUS_K:-$BLOCK_K}"
  fi
  MAX_MODEL_LEN="$(checkpoint_ctx)"
  log "dspark block=$BLOCK_K k=$MTP_NUM_TOKENS context=$MAX_MODEL_LEN"
  if [ "$ENGINE" = "021" ]; then
    # The 0.21 engine crashes on k>5 ("size of tensor a (7) must match b (5)").
    [ "$MTP_NUM_TOKENS" -le 5 ] || fatal "k=$MTP_NUM_TOKENS unsupported on the 021 lane (crashes >5)"
  else
    # 0.25+: any k >= block is legal — the drafter extends its block in the
    # same parallel pass. k < block is rejected by the engine itself.
    [ "$MTP_NUM_TOKENS" -ge "$BLOCK_K" ] || fatal "k=$MTP_NUM_TOKENS < drafter block $BLOCK_K"
  fi

  # Also catches a bad VENTUS_THINKING from the environment, not just --thinking.
  case "$DEFAULT_THINKING" in
    off|low|high|max) ;;
    *) fatal "thinking level '$DEFAULT_THINKING' invalid: use off, low, high or max" ;;
  esac
  log "reasoning default: $DEFAULT_THINKING (request-level overrides win)"

  gen_env
  log "env -> $ENV_FILE"
  if [ "$DRY_RUN" = "1" ]; then
    log "dry run: not touching docker. To start, drop --dry-run."
    sed 's/^/    /' "$ENV_FILE"
    return 0
  fi

  log "syncing to worker $WORKER and starting worker rank..."
  run_worker "mkdir -p ~/.ventus-dspark"
  scp "${SSH_OPTS[@]}" "$COMPOSE" "${WORKER_USER}@$WORKER:~/.ventus-dspark/ventus-dspark.yml"
  scp "${SSH_OPTS[@]}" "$ENV_FILE" "${WORKER_USER}@$WORKER:~/.ventus-dspark/env.dspark"
  # --force-recreate: a TP rank from a previous NCCL world must never be
  # reused — compose sees "same config, already running" and keeps a zombie
  # whose TCPStore is dead, and the new head waits on it forever (lived
  # 2026-08-04 during the first fleet-boot drill).
  run_worker "cd ~/.ventus-dspark && NODE_RANK=1 HEADLESS=1 VLLM_HOST_IP=$WORKER docker compose --env-file env.dspark -f ventus-dspark.yml up -d --force-recreate"

  log "starting head rank..."
  cd "$SCRIPT_DIR"
  NODE_RANK=0 HEADLESS= docker compose --env-file "$ENV_FILE" -f "$COMPOSE" up -d --force-recreate

  log "waiting for API on :$VLLM_PORT (cold boot ~15 min)..."
  local i=0
  until curl -fsS --max-time 5 "http://127.0.0.1:$VLLM_PORT/health" >/dev/null 2>&1; do
    i=$((i+1)); [ "$i" -gt 100 ] && fatal "API did not come up in 25 min — see 'docker compose logs'"
    sleep 15
  done
  log "serving: http://$(hostname):$VLLM_PORT — model /models/$(basename "$MODEL")"
}

# --- status -----------------------------------------------------------------
#
# Reads the generated env file rather than re-probing, so `status` reports the
# fleet as it was actually launched — re-probing could report a healthy IB port
# that the running server is not using.
#
# Draft acceptance is printed next to decode on purpose. Decode speed on this
# hardware tracks acceptance almost linearly (~20 + 65*alpha, docs/VALIDATION.md),
# so a tok/s number without its alpha is not interpretable: a slow run usually
# means an unpredictable prompt, not a broken fleet.

# Hardware telemetry for one node. `local` runs here; anything else is a
# worker reached over ssh with the probe on stdin, so nothing has to be copied
# to the node first.
#
# Results are cached for NODE_PROBE_TTL seconds (default 10). Hardware state
# moves slowly and an ssh round trip is ~300 ms per node, so a dashboard
# polling every couple of seconds must not open an ssh connection every time.
NODE_PROBE_TTL="${VENTUS_NODE_PROBE_TTL:-10}"
node_probe() {
  local node="$1" cache age now
  cache="${TMPDIR:-/tmp}/.ventus-node-${node//[^A-Za-z0-9]/_}"
  now="$(date +%s)"
  if [ -s "$cache" ]; then
    age=$(( now - $(awk 'NR==1{print $1}' "$cache" 2>/dev/null || echo 0) ))
    if [ "$age" -ge 0 ] && [ "$age" -lt "$NODE_PROBE_TTL" ]; then
      tail -n +2 "$cache"
      return 0
    fi
  fi
  local out
  if [ "$node" = "local" ]; then
    out="$(bash "$SCRIPT_DIR/scripts/node-probe.sh" 2>/dev/null)"
  else
    out="$(ssh "${SSH_OPTS[@]}" "${WORKER_USER}@$node" "bash -s" \
           < "$SCRIPT_DIR/scripts/node-probe.sh" 2>/dev/null)"
  fi
  # Only refresh the cache on a real answer: a transient ssh failure should
  # not blank a node that was healthy a second ago.
  if [ -n "$out" ]; then
    { printf '%s\n' "$now"; printf '%s\n' "$out"; } > "$cache" 2>/dev/null
    printf '%s\n' "$out"
  elif [ -s "$cache" ]; then
    tail -n +2 "$cache"
  fi
}

# One node row: hardware only. The lines above answer "is the fleet serving";
# this answers "is the box healthy" — the question that goes unasked until a
# node wedges (lived 2026-08-05).
node_row() {
  local label="$1" probe="$2"
  [ -n "$probe" ] || { printf '  %-12s %s\n' "$label" "unreachable"; return 0; }
  local temp util mem load disk nvrm up
  temp="$(printf '%s\n' "$probe" | awk -F= '$1=="gpu_temp_c"{print $2}')"
  util="$(printf '%s\n' "$probe" | awk -F= '$1=="gpu_util_pct"{print $2}')"
  mem="$(printf '%s\n' "$probe" | awk -F= '$1=="mem_used_pct"{print $2}')"
  load="$(printf '%s\n' "$probe" | awk -F= '$1=="load1"{print $2}')"
  disk="$(printf '%s\n' "$probe" | awk -F= '$1=="disk_used_pct"{print $2}')"
  nvrm="$(printf '%s\n' "$probe" | awk -F= '$1=="nvrm_oom"{print $2}')"
  up="$(printf '%s\n' "$probe" | awk -F= '$1=="uptime_h"{print $2}')"

  # Thresholds that matter on GB10: unified memory is the wedge risk and the
  # NVRM allocation failures are its early symptom.
  local red=$'\033[31m' off=$'\033[0m' memc="" tempc="" warn=""
  awk -v m="${mem:-0}" 'BEGIN{ exit !(m+0 > 92) }' && { memc="$red"; warn="mem"; }
  awk -v t="${temp:-0}" 'BEGIN{ exit !(t+0 > 85) }' && { tempc="$red"; warn="${warn:+$warn, }temp"; }

  printf '  %-12s %s%s°C%s  gpu %s%%  mem %s%s%%%s  load %s  disk %s%%  up %sh  nvrm %s\n' \
    "$label" "$tempc" "${temp:-?}" "$off" "${util:-?}" \
    "$memc" "${mem:-?}" "$off" "${load:-?}" "${disk:-?}" "${up:-?}" "${nvrm:-?}"
  [ -n "$warn" ] && printf '  %-12s %s^ %s over threshold%s\n' "" "$red" "$warn" "$off"
  return 0
}

# Pull one Prometheus sample out of $METRICS. Handles both bare names and
# label sets: `vllm:num_requests_running{model_name="..."} 2.0`.
metric() {
  printf '%s\n' "$METRICS" | awk -v k="$1" '
    index($0, k) == 1 && (substr($0, length(k)+1, 1) ~ /[{ ]/) { v = $NF }
    END { if (v != "") print v }'
}

# Trim trailing zeros so 0.580000 prints as 0.58.
fmt() { LC_ALL=C printf '%.*f' "${2:-2}" "$1" 2>/dev/null || printf '%s' "$1"; }

cmd_status() {
  [ -f "$ENV_FILE" ] || fatal "no fleet configured — run '$0 up --worker <ip>' first"
  # shellcheck disable=SC1090
  set -a; . "$ENV_FILE"; set +a

  local port="${VLLM_PORT:-8000}" worker="${WORKER_HOST:-?}"
  # run_worker() ssh's to the global $WORKER; without --worker on the command
  # line that is empty and every worker probe silently fails. The generated env
  # is the authority here — status must describe the fleet as launched.
  [ -n "${WORKER:-}" ] || WORKER="$worker"
  local base="http://127.0.0.1:$port"

  # --- head ---
  local head_state="down"
  curl -fsS --max-time 5 "$base/health" >/dev/null 2>&1 && head_state="up"

  # --- worker --- reachable over ssh AND running a container. A worker that
  # answers ssh but has no container is the failure this line exists to catch.
  local worker_state="unreachable"
  if [ "$worker" != "?" ]; then
    if run_worker "docker ps --filter name=dspark --format '{{.State}}' | head -1" 2>/dev/null | grep -q running; then
      worker_state="up"
    elif run_worker true 2>/dev/null; then
      worker_state="ssh ok, no container"
    fi
  fi

  printf '\n  \033[1mventus-dspark\033[0m — fleet status\n\n'
  printf '  %-12s head %s   worker %s (%s)\n' "nodes" \
    "$([ "$head_state" = up ] && echo ✓ || echo ✗)" \
    "$([ "$worker_state" = up ] && echo ✓ || echo ✗)" "$worker"
  printf '  %-12s %s  gid=%s  %s\n' "IB" \
    "${NCCL_IB_HCA:-?}" "${NCCL_IB_GID_INDEX:-?}" \
    "$([ -n "${NCCL_IB_HCA:-}" ] && echo "RoCEv2" || echo "not probed")"

  if [ "$head_state" != up ]; then
    printf '  %-12s API not answering on :%s — try: docker compose logs\n\n' "" "$port"
    [ "$worker_state" = up ] || printf '  %-12s worker: %s\n\n' "" "$worker_state"
    return 1
  fi

  METRICS="$(curl -fsS --max-time 5 "$base/metrics" 2>/dev/null || true)"

  local model ctx
  model="$(curl -fsS --max-time 5 "$base/v1/models" 2>/dev/null \
    | grep -o '"id":"[^"]*"' | head -1 | cut -d'"' -f4)"
  ctx="${MAX_MODEL_LEN:-}"
  printf '  %-12s %s   ctx %s\n' "model" "${model:-?}" \
    "$(LC_ALL=C printf "%'d" "${ctx:-0}" 2>/dev/null || echo "${ctx:-?}")"

  # KV pool. vLLM exposes a 0..1 fraction; the absolute pool size is only in
  # the boot log, so report the percentage and let the operator size from it.
  local kv; kv="$(metric 'vllm:kv_cache_usage_perc')"
  [ -n "$kv" ] && printf '  %-12s %s%% used\n' "KV pool" "$(fmt "$(echo "$kv 100" | awk '{print $1*$2}')" 1)"

  local run wait_; run="$(metric 'vllm:num_requests_running')"; wait_="$(metric 'vllm:num_requests_waiting')"
  [ -n "$run" ] && printf '  %-12s %s running, %s queued (max %s)\n' "streams" \
    "$(fmt "${run:-0}" 0)" "$(fmt "${wait_:-0}" 0)" "${MAX_NUM_SEQS:-?}"

  # Acceptance: prefer the gauge, fall back to the counters. Metric names have
  # moved between vLLM releases and both lanes are supported, so try each.
  local alpha acc draft
  alpha="$(metric 'vllm:spec_decode_draft_acceptance_rate')"
  if [ -z "$alpha" ]; then
    acc="$(metric 'vllm:spec_decode_num_accepted_tokens_total')"
    draft="$(metric 'vllm:spec_decode_num_draft_tokens_total')"
    if [ -n "$acc" ] && [ -n "$draft" ]; then
      alpha="$(awk -v a="$acc" -v d="$draft" 'BEGIN{ if (d+0 > 0) print a/d }')"
    fi
  fi

  # Decode rate. 0.25 exposes only a cumulative token counter (the 0.21-era
  # avg_generation_throughput gauge is gone), so sample it twice and divide.
  # Idle fleets have no rate to report — that is a dash, not a fault.
  local tps t0 t1
  t0="$(metric 'vllm:generation_tokens_total')"
  if [ -n "$t0" ]; then
    sleep 2
    t1="$(printf '%s' "$(curl -fsS --max-time 5 "$base/metrics" 2>/dev/null || true)"           | awk -v k='vllm:generation_tokens_total' '
              index($0, k) == 1 && (substr($0, length(k)+1, 1) ~ /[{ ]/) { v = $NF }
              END { if (v != "") print v }')"
    tps="$(awk -v a="$t0" -v b="$t1" 'BEGIN{ d=(b-a)/2; if (d > 0.05) print d }')"
  fi
  if [ -n "$tps" ] || [ -n "$alpha" ]; then
    # ${x:+a}${x:-b} prints BOTH branches when x is set — format once instead.
    local shown="–"; [ -n "$tps" ] && shown="$(fmt "$tps" 1)"
    printf '  %-12s %s tok/s' "decode" "$shown"
    [ -n "$alpha" ] && printf '     \033[36m← α %s\033[0m' "$(fmt "$alpha")"
    printf '\n'
  fi
  [ -n "$alpha" ] && awk -v a="$alpha" 'BEGIN{
    if (a+0 < 0.45) print "  " sprintf("%-12s","") "low α — unpredictable prompts, not a fleet fault"
  }'

  printf '\n'
  node_row "head" "$(node_probe local)"
  [ "$worker" != "?" ] && node_row "worker" "$(node_probe "$worker")"

  printf '\n'
}

# --- dashboard --------------------------------------------------------------
#
# Optional, and deliberately in its own compose file: it has to be able to
# start, stop and crash without touching a serving fleet.
DASHBOARD_COMPOSE="$SCRIPT_DIR/compose/ventus-dashboard.yml"

# Host-side node telemetry collector.
#
# The dashboard container has no ssh keys and no nvidia-smi, and granting it
# either just to read a temperature would be a poor trade. So the host — which
# already has both — samples each node on a loop and drops key=value files the
# container reads through a read-only mount.
#
# One background loop rather than a probe per HTTP request: hardware moves
# slowly, several browsers may be watching, and nothing should be able to turn
# a page refresh into an ssh connection.
telemetry_loop() {
  local dir="$1" worker="$2" interval="${VENTUS_NODE_PROBE_TTL:-10}"
  local idle_after="${VENTUS_TELEMETRY_IDLE:-45}" now watch_age
  mkdir -p "$dir"
  while :; do
    # Exit check first, and before the idle gate below: an idle collector must
    # still notice its dashboard is gone, or it spins forever with nothing to
    # feed.
    docker ps --filter name=ventus-dspark-dashboard --format '{{.Names}}' 2>/dev/null \
      | grep -q . || { rm -f "$dir/head" "$dir/worker" "$dir/.watch" 2>/dev/null; exit 0; }

    # Probe only while somebody is watching. The dashboard tracks the last
    # viewer request and reports it on /api/idle; an open browser keeps this
    # sampling, a closed tab lets it fall idle within one interval. Monitoring
    # that burns 1.5% of a core around the clock for nobody's benefit is not
    # free monitoring.
    #
    # Asked over HTTP rather than through a shared file: the container runs
    # unprivileged and cannot write to the mount, and giving it write access
    # just to leave a timestamp would be the wrong trade.
    watch_age="$(curl -fsS --max-time 3 "http://127.0.0.1:${DASH_PORT:-8500}/api/idle" 2>/dev/null \
                 | sed -n 's/.*"idle_s"[: ]*\([0-9.]*\).*/\1/p' | cut -d. -f1)"
    if [ -n "$watch_age" ] && [ "$watch_age" -le "$idle_after" ]; then
      node_probe local > "$dir/.head.tmp" 2>/dev/null && mv -f "$dir/.head.tmp" "$dir/head"
      if [ -n "$worker" ] && [ "$worker" != "?" ]; then
        node_probe "$worker" > "$dir/.worker.tmp" 2>/dev/null && mv -f "$dir/.worker.tmp" "$dir/worker"
      fi
    fi
    sleep "$interval"
  done
}

cmd_dashboard() {
  if [ "${DASH_STOP:-0}" = "1" ]; then
    cd "$SCRIPT_DIR"
    docker compose --env-file "$ENV_FILE" -f "$DASHBOARD_COMPOSE" down >/dev/null 2>&1 || true
    # The collector notices the container is gone on its next tick and exits
    # on its own; kill it now so "stop" means stopped, not "stopped shortly".
    pkill -f "ventus-telemetry-collector" 2>/dev/null || true
    rm -rf "${VENTUS_TELEMETRY_DIR:-/tmp/ventus-telemetry}" 2>/dev/null || true
    log "dashboard stopped, telemetry collector stopped, samples removed"
    return 0
  fi
  [ -f "$ENV_FILE" ] || fatal "no fleet configured — run '$0 up --worker <ip>' first"
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  local dir="${VENTUS_TELEMETRY_DIR:-/tmp/ventus-telemetry}"
  [ -n "${WORKER:-}" ] || WORKER="${WORKER_HOST:-}"

  # Replace any collector from a previous run so the interval and worker
  # address always match this invocation.
  pkill -f "ventus-telemetry-collector" 2>/dev/null || true
  ( exec -a ventus-telemetry-collector bash -c \
      "$(declare -f node_probe telemetry_loop); \
       SCRIPT_DIR='$SCRIPT_DIR'; WORKER_USER='$WORKER_USER'; \
       SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=8); \
       NODE_PROBE_TTL=0; \
       telemetry_loop '$dir' '${WORKER:-}'" >/dev/null 2>&1 & )
  log "telemetry collector -> $dir (every ${VENTUS_NODE_PROBE_TTL:-10}s)"

  cd "$SCRIPT_DIR"
  # Rebuild only when it would change something: on every invocation it
  # orphans the previous layer and those dangling images pile up unnoticed
  # (six within a day of first use), but never rebuilding ships a stale UI
  # after a source edit. So compare the image against the source mtimes.
  local build_flag=() img_epoch=0 src_epoch=0
  img_epoch="$(docker image inspect ventus/dspark-dashboard:0.1.0 \
                 --format '{{.Created}}' 2>/dev/null | xargs -r date +%s -d 2>/dev/null || echo 0)"
  src_epoch="$(find "$SCRIPT_DIR/dashboard" -type f -printf '%T@\n' 2>/dev/null \
                 | sort -rn | head -1 | cut -d. -f1)"
  if [ "${DASH_REBUILD:-0}" = "1" ] || [ "${img_epoch:-0}" -eq 0 ] \
     || [ "${src_epoch:-0}" -gt "${img_epoch:-0}" ]; then
    build_flag=(--build)
    log "dashboard source newer than image — rebuilding"
  fi
  DASH_PORT="$DASH_PORT" NODE_TELEMETRY_DIR="$dir" \
    docker compose --env-file "$ENV_FILE" -f "$DASHBOARD_COMPOSE" up -d "${build_flag[@]}"
  log "dashboard: http://$(hostname):$DASH_PORT"
}

cmd_down() {
  [ -n "$WORKER" ] || { usage; fatal "--worker is required"; }
  cd "$SCRIPT_DIR"
  # Best-effort: the dashboard may never have been started.
  DASH_PORT="$DASH_PORT" docker compose --env-file "$ENV_FILE" -f "$DASHBOARD_COMPOSE" down 2>/dev/null || true
  docker compose --env-file "$ENV_FILE" -f "$COMPOSE" down 2>/dev/null || true
  run_worker "cd ~/.ventus-dspark && docker compose --env-file env.dspark -f ventus-dspark.yml down" 2>/dev/null || true
  log "stopped on both nodes"
}

WORKER=""; MODEL="$HOME/models/v4-flash-0731"
while [ $# -gt 0 ]; do
  case "$1" in
    up) CMD=up ;;
    down) CMD=down ;;
    status) CMD=status ;;
    dashboard) CMD=dashboard ;;
    --stop) DASH_STOP=1 ;;
    --dry-run) DRY_RUN=1 ;;
    --worker) WORKER="$2"; shift ;;
    --model) MODEL="$2"; shift ;;
    --port) VLLM_PORT="$2"; shift ;;
    --dash-port) DASH_PORT="$2"; shift ;;
    --image) IMAGE="$2"; shift ;;
    --thinking)
      case "$2" in
        off|low|high|max) DEFAULT_THINKING="$2" ;;
        *) fatal "--thinking must be one of: off low high max (got '$2')" ;;
      esac
      shift ;;
    --engine) ENGINE="$2"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage; fatal "unknown argument: $1" ;;
  esac
  shift
done
resolve_engine
case "${CMD:-}" in
  up) cmd_up ;;
  down) cmd_down ;;
  status) cmd_status ;;
  dashboard) cmd_dashboard ;;
  *) usage; fatal "command required: up | down | status | dashboard" ;;
esac
